# Copy to .env: cp .env.example .env
# Only JWT_ACCESS_SECRET must be filled in for local development.
# Every other option and its default lives in backend-timuboard/src/config/env.validation.ts.

# Database (Postgres from docker compose, exposed on port 5433)
POSTGRES_DB=timuboard
POSTGRES_USER=timuboard
POSTGRES_PASSWORD=timuboard
DB_HOST=localhost
DB_PORT=5433

# Redis (rate limiting and realtime)
REDIS_URL=redis://localhost:6379

# API
PORT=3000
FRONTEND_URL=http://localhost:5173
# Required, at least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Email (Mailpit in development, inbox at http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=Timuboard <no-reply@timuboard.local>

# Google Sign-In (optional, Web client ID; leave empty to hide the button)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
